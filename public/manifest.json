{
  "manifest_version": 3,
  "name": "LaTeX on X",
  "version": "0.1.0",
  "description": "Renderiza fórmulas matemáticas en LaTeX (\\(...\\), $$...$$ y \\[...\\]) dentro de X (x.com) usando KaTeX, sin colisiones con precios ni cashtags.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LaTeX on X",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["katex.min.css", "styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
